# ---- Local development only. Never commit real values. ----
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_only

DB_NAME=hypersender
TEST_DB_NAME=hypersender_test

# Migration / admin role (owns schema objects, BYPASSRLS). Used only by CI migration jobs.
DB_OWNER_USER=hs_owner
DB_OWNER_PASSWORD=owner_dev_only
# API / request-serving role (RLS enforced).
DB_APP_USER=hs_app
DB_APP_PASSWORD=app_dev_only
# Background worker role (RLS enforced; cross-tenant only on queue tables).
DB_WORKER_USER=hs_worker
DB_WORKER_PASSWORD=worker_dev_only

# Pepper for API-key HMAC. In production load from KMS/Secrets Manager.
API_KEY_PEPPER=dev-only-pepper-change-me-0123456789abcdef
# Local-only 32-byte base64 master key for the LocalKeyProvider (tests/dev).
# Production MUST use AWS KMS (KMS_KEY_ID) - LocalKeyProvider refuses NODE_ENV=production.
LOCAL_MASTER_KEY_BASE64=ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcyEhISE=
KMS_KEY_ID=
AWS_REGION=ap-south-1

# ---- Phase 2: API / WhatsApp gateway (dev values only) ----
PORT=3100
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
# 32-byte base64 key shared by API + workers to encrypt realtime (QR) payloads on LISTEN/NOTIFY
REALTIME_BUS_KEY=ZGV2LW9ubHktcmVhbHRpbWUta2V5LTMyLWJ5dGVzISE=
# pg (multi-process, default) | memory (single process tests)
REALTIME_BUS=pg
INTERNAL_OPS_TOKEN=dev-only-ops-token-change-me
MEDIA_STORAGE_PROVIDER=LOCAL_DEV
MEDIA_LOCAL_DIR=.data/media

WHATSAPP_PROVIDER=baileys
# Stable id lets a restarted worker immediately reclaim its own sessions (UUID). Empty = random per start.
WHATSAPP_WORKER_ID=
WHATSAPP_WORKER_CAPACITY=200
WHATSAPP_RESTORE_CONCURRENCY=5
WHATSAPP_RECONNECT_MIN_DELAY_MS=2000
WHATSAPP_RECONNECT_MAX_DELAY_MS=120000
WHATSAPP_MAX_RECONNECT_ATTEMPTS=50
WHATSAPP_WORKER_HEARTBEAT_INTERVAL_MS=10000
WHATSAPP_WORKER_STALE_AFTER_MS=45000
WHATSAPP_ORPHAN_SCAN_INTERVAL_MS=30000
WHATSAPP_QR_TIMEOUT_MS=30000
WHATSAPP_MEDIA_MAX_BYTES=16777216
WHATSAPP_SEND_MIN_INTERVAL_MS=1000
WHATSAPP_SEND_QUEUE_TTL_SECONDS=3600
WHATSAPP_API_SEND_RATE_PER_MINUTE=60
WHATSAPP_HONOUR_APPEAR_ONLINE=false
WEBHOOK_TIMEOUT_MS=10000
# Only for local testing against http tunnels/localhost-resolving hosts. NEVER in production.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
BAILEYS_LOG_LEVEL=warn
LOG_MESSAGE_CONTENT=false

# --- AI assistants (Phase 4) ---
# Without OPENAI_API_KEY assistants never answer live customers (safe fallback + handoff)
# and the Test Assistant says the AI service is not configured.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_MODEL=gpt-5-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MODEL_TIMEOUT_MS=30000
AI_ASSISTANTS_ENABLED=true
AI_SANDBOX_TURNS_PER_10_MIN=60

# Google Calendar for Pandit Ji (docs/google-calendar.md). Leave empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API_PUBLIC_URL=http://localhost:3100
# WEB_APP_URL=http://localhost:3200
